<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Automated Daily Cron for Recurring Billing Generation -->
        <record id="ir_cron_brightloop_recurring_billing" model="ir.cron">
            <field name="name">Brightloop: Automated Daily Recurring Invoicing</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Automated Daily Cron for Upcoming Renewal Reminders (3 Days in Advance) -->
        <record id="ir_cron_brightloop_renewal_reminders" model="ir.cron">
            <field name="name">Brightloop: Dispatch Upcoming Renewal Reminders</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_renewal_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. Automated Daily Cron for Dunning & Grace Period Enforcement -->
        <record id="ir_cron_brightloop_check_grace_periods" model="ir.cron">
            <field name="name">Brightloop: Dunning &amp; Grace Period Monitor</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_grace_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- 4. Automated Daily Cron for Contract Term Expirations -->
        <record id="ir_cron_brightloop_check_expirations" model="ir.cron">
            <field name="name">Brightloop: Contract Expirations &amp; Term Closer</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expirations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
