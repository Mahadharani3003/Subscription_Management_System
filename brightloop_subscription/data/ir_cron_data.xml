<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Automated Daily Cron for Recurring Billing Generation -->
        <record id="ir_cron_brightloop_recurring_billing" model="ir.cron">
            <field name="name">Brightloop: Automated Daily Recurring Invoicing</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Automated Daily Cron for Dunning & Grace Period Enforcement -->
        <record id="ir_cron_brightloop_check_grace_periods" model="ir.cron">
            <field name="name">Brightloop: Dunning &amp; Grace Period Monitor</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_grace_periods()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
