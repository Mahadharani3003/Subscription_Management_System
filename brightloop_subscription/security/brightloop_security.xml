<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_brightloop" model="ir.module.category">
            <field name="name">Brightloop Subscriptions</field>
            <field name="description">Manage subscription plans, recurring billing contracts, and churn analytics.</field>
            <field name="sequence">15</field>
        </record>

        <!-- Subscription Officer / User Group -->
        <record id="group_brightloop_user" model="res.groups">
            <field name="name">Subscription Officer</field>
            <field name="category_id" ref="module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Operational access: can manage customer subscriptions, generate invoices, pause/resume contracts, and log notes.</field>
        </record>

        <!-- Subscription Administrator / Manager Group -->
        <record id="group_brightloop_manager" model="res.groups">
            <field name="name">Subscription Administrator</field>
            <field name="category_id" ref="module_category_brightloop"/>
            <field name="implied_ids" eval="[(4, ref('group_brightloop_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full managerial access: can configure subscription plans, churn categories, billing defaults, and system parameters.</field>
        </record>
    </data>

    <!-- Record Rules (Multi-Company & Portal Access) -->
    <data noupdate="1">
        <!-- Multi-Company Rule: brightloop.plan -->
        <record id="brightloop_plan_multicompany_rule" model="ir.rule">
            <field name="name">Brightloop Plan: Multi-Company Rule</field>
            <field name="model_id" ref="model_brightloop_plan"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Multi-Company Rule: brightloop.subscription -->
        <record id="brightloop_subscription_multicompany_rule" model="ir.rule">
            <field name="name">Brightloop Subscription: Multi-Company Rule</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Multi-Company Rule: brightloop.subscription.line -->
        <record id="brightloop_subscription_line_multicompany_rule" model="ir.rule">
            <field name="name">Brightloop Subscription Line: Multi-Company Rule</field>
            <field name="model_id" ref="model_brightloop_subscription_line"/>
            <field name="domain_force">['|', ('subscription_id.company_id', '=', False), ('subscription_id.company_id', 'in', company_ids)]</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Portal Customer Rule: brightloop.subscription (Read-only own records) -->
        <record id="brightloop_subscription_portal_rule" model="ir.rule">
            <field name="name">Brightloop Subscription: Portal Customer Own Subscriptions</field>
            <field name="model_id" ref="model_brightloop_subscription"/>
            <field name="domain_force">['|', ('partner_id', '=', user.partner_id.id), ('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Customer Rule: brightloop.subscription.line -->
        <record id="brightloop_subscription_line_portal_rule" model="ir.rule">
            <field name="name">Brightloop Subscription Line: Portal Customer Own Lines</field>
            <field name="model_id" ref="model_brightloop_subscription_line"/>
            <field name="domain_force">['|', ('subscription_id.partner_id', '=', user.partner_id.id), ('subscription_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
