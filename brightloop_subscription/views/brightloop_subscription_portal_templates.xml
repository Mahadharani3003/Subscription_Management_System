<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Add Subscriptions Link to Customer Portal Home (/my) -->
    <template id="portal_my_home_menu_subscription" name="Portal layout : subscription menu entries" inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'subscription' or subscription" t-attf-class="breadcrumb-item #{'active ' if not subscription else ''}">
                <a t-if="subscription" t-attf-href="/my/subscriptions?{{ keep_query() }}">Subscriptions</a>
                <t t-else="">Subscriptions</t>
            </li>
            <li t-if="subscription" class="breadcrumb-item active">
                <t t-out="subscription.name"/>
            </li>
        </xpath>
    </template>

    <template id="portal_my_home_subscription" name="Show Subscriptions" inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
        </xpath>
    </template>

    <!-- 2. Subscriptions List View (/my/subscriptions) -->
    <template id="portal_my_subscriptions" name="My Subscriptions">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Subscriptions</t>
            </t>
            <t t-if="not subscriptions">
                <div class="alert alert-info" role="alert">
                    There are no active or past subscriptions associated with your account.
                </div>
            </t>
            <t t-if="subscriptions" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Reference</th>
                        <th>Plan</th>
                        <th>Billing Cadence</th>
                        <th class="text-end">Recurring Amount</th>
                        <th class="text-center">Status</th>
                        <th>Next Billing Date</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="subscriptions" t-as="sub">
                        <tr>
                            <td>
                                <a t-attf-href="/my/subscriptions/#{sub.id}" class="fw-bold">
                                    <t t-out="sub.name"/>
                                </a>
                            </td>
                            <td><t t-out="sub.plan_id.name"/></td>
                            <td>Every <t t-out="sub.plan_id.billing_interval_count"/> <t t-out="sub.plan_id.billing_interval"/>(s)</td>
                            <td class="text-end fw-bold">
                                <t t-out="sub.recurring_total" t-options="{'widget': 'monetary', 'display_currency': sub.currency_id}"/>
                            </td>
                            <td class="text-center">
                                <span t-if="sub.state == 'active'" class="badge text-bg-success">Active</span>
                                <span t-elif="sub.state == 'trial'" class="badge text-bg-info">Free Trial</span>
                                <span t-elif="sub.state == 'past_due'" class="badge text-bg-danger">Past Due</span>
                                <span t-elif="sub.state == 'paused'" class="badge text-bg-warning">Paused</span>
                                <span t-else="" class="badge text-bg-secondary"><t t-out="sub.state"/></span>
                            </td>
                            <td><t t-out="sub.next_billing_date or '-'"/></td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

    <!-- 3. Subscription Detail View (/my/subscriptions/<id>) -->
    <template id="portal_subscription_page" name="My Subscription">
        <t t-call="portal.portal_layout">
            <div class="container my-3">
                <div class="card shadow-sm border">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                        <div>
                            <h3 class="mb-0 text-primary fw-bold">
                                Subscription <t t-out="subscription.name"/>
                            </h3>
                            <span class="text-muted small">Started on <t t-out="subscription.start_date"/></span>
                        </div>
                        <div>
                            <span t-if="subscription.state == 'active'" class="badge text-bg-success fs-6 px-3 py-2">ACTIVE</span>
                            <span t-elif="subscription.state == 'trial'" class="badge text-bg-info fs-6 px-3 py-2">FREE TRIAL</span>
                            <span t-elif="subscription.state == 'past_due'" class="badge text-bg-danger fs-6 px-3 py-2">PAST DUE</span>
                            <span t-elif="subscription.state == 'paused'" class="badge text-bg-warning fs-6 px-3 py-2">PAUSED</span>
                            <span t-else="" class="badge text-bg-secondary fs-6 px-3 py-2"><t t-out="subscription.state"/></span>
                        </div>
                    </div>

                    <div class="card-body">
                        <!-- Key Metric Cards -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border text-center">
                                    <span class="text-muted small text-uppercase fw-bold">Current Tier</span>
                                    <h4 class="mt-1 fw-bold text-dark"><t t-out="subscription.plan_id.name"/></h4>
                                    <span class="badge text-bg-primary-subtle text-primary border"><t t-out="subscription.plan_id.code"/></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border text-center">
                                    <span class="text-muted small text-uppercase fw-bold">Recurring Total</span>
                                    <h4 class="mt-1 fw-bold text-primary">
                                        <t t-out="subscription.recurring_total" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/>
                                    </h4>
                                    <span class="text-muted small">every <t t-out="subscription.plan_id.billing_interval_count"/> <t t-out="subscription.plan_id.billing_interval"/></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="p-3 bg-light rounded border text-center">
                                    <span class="text-muted small text-uppercase fw-bold">Next Renewal</span>
                                    <h4 class="mt-1 fw-bold text-dark"><t t-out="subscription.next_billing_date or '-'"/></h4>
                                    <span t-if="subscription.auto_renew" class="text-success small"><i class="fa fa-check-circle me-1"/>Auto-renew active</span>
                                </div>
                            </div>
                        </div>

                        <!-- Self-Service Action Bar -->
                        <div class="p-3 bg-light rounded border mb-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="fw-bold">Subscriber Self-Service Actions</span>
                                <p class="text-muted small mb-0">Manage contract status or suspend services directly.</p>
                            </div>
                            <div class="d-flex gap-2">
                                <form t-if="subscription.state == 'active'" t-attf-action="/my/subscriptions/#{subscription.id}/pause" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        <i class="fa fa-pause me-1"/> Pause Services
                                    </button>
                                </form>
                                <form t-if="subscription.state == 'paused'" t-attf-action="/my/subscriptions/#{subscription.id}/resume" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fa fa-play me-1"/> Resume Subscription
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Add-on Items Table -->
                        <h5 class="fw-bold text-dark mb-3"><i class="fa fa-cubes me-2 text-primary"/>Active Plan &amp; Add-on Items</h5>
                        <table class="table table-bordered mb-4">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Description</th>
                                    <th class="text-center">Quantity / Seats</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong><t t-out="subscription.plan_id.name"/></strong> (Base Plan)</td>
                                    <td class="text-center">1.0</td>
                                    <td class="text-end"><t t-out="subscription.plan_id.price" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></td>
                                    <td class="text-end fw-bold"><t t-out="subscription.plan_id.price" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></td>
                                </tr>
                                <tr t-foreach="subscription.line_ids" t-as="line">
                                    <td><t t-out="line.name"/></td>
                                    <td class="text-center"><t t-out="line.quantity"/></td>
                                    <td class="text-end"><t t-out="line.unit_price" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></td>
                                    <td class="text-end fw-bold"><t t-out="line.subtotal" t-options="{'widget': 'monetary', 'display_currency': subscription.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Linked Billing Invoices -->
                        <h5 class="fw-bold text-dark mb-3"><i class="fa fa-file-text-o me-2 text-primary"/>Billing &amp; Payment History</h5>
                        <t t-if="not invoices">
                            <p class="text-muted">No historical invoices issued yet.</p>
                        </t>
                        <t t-if="invoices">
                            <table class="table table-hover border">
                                <thead class="table-light">
                                    <tr>
                                        <th>Invoice Reference</th>
                                        <th>Invoice Date</th>
                                        <th>Due Date</th>
                                        <th class="text-end">Total Amount</th>
                                        <th class="text-center">Payment Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="invoices" t-as="inv">
                                        <td class="fw-bold"><t t-out="inv.name"/></td>
                                        <td><t t-out="inv.invoice_date"/></td>
                                        <td><t t-out="inv.invoice_date_due"/></td>
                                        <td class="text-end fw-bold">
                                            <t t-out="inv.amount_total" t-options="{'widget': 'monetary', 'display_currency': inv.currency_id}"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-if="inv.payment_state in ('paid', 'in_payment')" class="badge text-bg-success">Paid</span>
                                            <span t-elif="inv.payment_state == 'partial'" class="badge text-bg-warning">Partial</span>
                                            <span t-else="" class="badge text-bg-danger">Unpaid</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ========================================================================= -->
    <!-- 4. FLOATING AI CHATBOT WIDGET FOR CUSTOMER PORTAL                         -->
    <!-- ========================================================================= -->
    <template id="brightloop_chatbot_widget" name="Brightloop AI Chatbot Widget">
        <!-- Floating Chatbot Launcher Button -->
        <div id="brightloop-chatbot-launcher" class="position-fixed" style="bottom: 24px; right: 24px; z-index: 9999;">
            <button id="brightloop-btn-toggle" class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center" 
                    style="width: 58px; height: 58px; background: linear-gradient(135deg, #714B67 0%, #017E84 100%); border: none; cursor: pointer; transition: transform 0.2s;"
                    title="Open Brightloop AI Assistant">
                <i class="fa fa-magic fs-4 text-white"></i>
            </button>
        </div>

        <!-- Floating Chatbot Window -->
        <div id="brightloop-chatbot-window" class="position-fixed shadow-lg rounded-4 overflow-hidden d-none flex-column" 
             style="bottom: 92px; right: 24px; width: 380px; max-width: calc(100vw - 32px); height: 530px; max-height: calc(100vh - 110px); z-index: 10000; background: #ffffff; border: 1px solid rgba(0,0,0,0.12);">
            
            <!-- Chat Header -->
            <div class="p-3 text-white d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, #714B67 0%, #017E84 100%);">
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-white rounded-circle p-1 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                        <i class="fa fa-robot text-primary fs-5" style="color: #714B67 !important;"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">Brightloop AI Assistant</h6>
                        <small class="text-white-50" style="font-size: 0.75rem;">
                            <span class="badge bg-success rounded-circle p-1 me-1" style="font-size: 0.35rem;"> </span>
                            Live Account Records Verified
                        </small>
                    </div>
                </div>
                <button id="brightloop-btn-close" class="btn btn-sm text-white p-0 border-0 fs-5" style="opacity: 0.85;" title="Minimize Chat">&#215;</button>
            </div>

            <!-- Chat Messages Scrollable Area -->
            <div id="brightloop-chat-messages" class="flex-grow-1 p-3 overflow-auto" style="background: #f8f9fa; font-size: 0.875rem;">
                <!-- Initial Welcome Bubble -->
                <div class="d-flex gap-2 mb-3">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem; background: #714B67 !important;">
                        AI
                    </div>
                    <div class="p-3 rounded-3 shadow-sm bg-white border text-dark" style="max-width: 85%;">
                        <p class="mb-2">
                            Hello <strong><t t-out="request.env.user.partner_id.name or 'Subscriber'"/></strong>! I am your <strong>Brightloop AI Assistant</strong>.
                        </p>
                        <p class="mb-2 text-muted" style="font-size: 0.82rem;">
                            I can look up your live subscription status, upcoming billing dates, recent invoices, or guide you through plan changes.
                        </p>
                        <div class="d-flex flex-wrap gap-1 mt-2">
                            <button class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 brightloop-chip" style="font-size: 0.75rem;" data-prompt="What is my current subscription status?">
                                📊 Subscription Status
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 brightloop-chip" style="font-size: 0.75rem;" data-prompt="When is my next billing date?">
                                📅 Next Billing Date
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 brightloop-chip" style="font-size: 0.75rem;" data-prompt="Show my recent invoices">
                                💳 Recent Invoices
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 brightloop-chip" style="font-size: 0.75rem;" data-prompt="How do I upgrade or downgrade my plan?">
                                🚀 Upgrade / Change Plan
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 brightloop-chip" style="font-size: 0.75rem;" data-prompt="What subscription plans are available?">
                                🌟 Available Plans
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Typing Indicator (Hidden by default) -->
            <div id="brightloop-typing" class="px-3 py-2 bg-light border-top d-none" style="font-size: 0.75rem; color: #6c757d;">
                <i class="fa fa-circle-o-notch fa-spin me-1"></i> Checking your authorized account records...
            </div>

            <!-- Chat Input Area -->
            <div class="p-2 border-top bg-white d-flex gap-2 align-items-center">
                <input id="brightloop-chat-input" type="text" class="form-control form-control-sm border-0 bg-light" 
                       placeholder="Ask about billing, renewals, or plans..." autocomplete="off"/>
                <button id="brightloop-btn-send" class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center" 
                        style="width: 34px; height: 34px; background: #714B67; border: none;" title="Send Message">
                    <i class="fa fa-paper-plane text-white" style="font-size: 0.75rem;"></i>
                </button>
            </div>
        </div>

        <!-- Chatbot JavaScript Controller -->
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
                var toggleBtn = document.getElementById('brightloop-btn-toggle');
                var closeBtn = document.getElementById('brightloop-btn-close');
                var chatWindow = document.getElementById('brightloop-chatbot-window');
                var chatInput = document.getElementById('brightloop-chat-input');
                var sendBtn = document.getElementById('brightloop-btn-send');
                var msgBox = document.getElementById('brightloop-chat-messages');
                var typingBox = document.getElementById('brightloop-typing');

                if (!toggleBtn || !chatWindow) return;

                function toggleChat() {
                    if (chatWindow.classList.contains('d-none')) {
                        chatWindow.classList.remove('d-none');
                        chatWindow.classList.add('d-flex');
                        chatInput.focus();
                    } else {
                        chatWindow.classList.remove('d-flex');
                        chatWindow.classList.add('d-none');
                    }
                }

                toggleBtn.addEventListener('click', toggleChat);
                closeBtn.addEventListener('click', toggleChat);

                function formatReply(text) {
                    if (!text) return '';
                    // Convert markdown bold to strong and linebreaks to br
                    var formatted = text
                        .replace(/\*\*(.*?)\*\*/g, '&lt;strong&gt;$1&lt;/strong&gt;')
                        .replace(/\*(.*?)\*/g, '&lt;em&gt;$1&lt;/em&gt;')
                        .replace(/\n\n/g, '&lt;br/&gt;&lt;br/&gt;')
                        .replace(/\n/g, '&lt;br/&gt;');
                    return formatted;
                }

                function appendMessage(sender, text) {
                    var div = document.createElement('div');
                    div.className = 'd-flex gap-2 mb-3 ' + (sender === 'user' ? 'justify-content-end' : '');
                    
                    if (sender === 'user') {
                        div.innerHTML = '&lt;div class="p-2 px-3 rounded-3 shadow-sm text-white" style="background: #017E84; max-width: 80%;"&gt;' +
                                        text + '&lt;/div&gt;';
                    } else {
                        div.innerHTML = '&lt;div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 28px; height: 28px; font-size: 0.75rem; background: #714B67 !important;"&gt;AI&lt;/div&gt;' +
                                        '&lt;div class="p-3 rounded-3 shadow-sm bg-white border text-dark" style="max-width: 85%;"&gt;' +
                                        formatReply(text) + '&lt;/div&gt;';
                    }
                    msgBox.appendChild(div);
                    msgBox.scrollTop = msgBox.scrollHeight;
                }

                function sendMessage(text) {
                    var query = (text || chatInput.value || '').trim();
                    if (!query) return;

                    appendMessage('user', query);
                    chatInput.value = '';
                    typingBox.classList.remove('d-none');
                    msgBox.scrollTop = msgBox.scrollHeight;

                    // Send JSON-RPC request to Odoo backend endpoint
                    fetch('/brightloop/chatbot/query', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            jsonrpc: '2.0',
                            method: 'call',
                            params: { message: query },
                            id: new Date().getTime()
                        })
                    })
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        typingBox.classList.add('d-none');
                        if (data.result &amp;&amp; data.result.reply) {
                            appendMessage('bot', data.result.reply);
                        } else if (data.error) {
                            appendMessage('bot', 'We encountered an error processing your query. Please refresh or try again.');
                        } else {
                            appendMessage('bot', 'No response received. Please try again.');
                        }
                    })
                    .catch(function(err) {
                        typingBox.classList.add('d-none');
                        appendMessage('bot', 'Network connection error. Please verify your internet connection.');
                    });
                }

                sendBtn.addEventListener('click', function() { sendMessage(); });
                chatInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        sendMessage();
                    }
                });

                // Attach click listeners to suggestion chips
                document.addEventListener('click', function(e) {
                    if (e.target &amp;&amp; e.target.classList.contains('brightloop-chip')) {
                        var prompt = e.target.getAttribute('data-prompt');
                        if (prompt) {
                            sendMessage(prompt);
                        }
                    }
                });
            });
        </script>
    </template>

    <!-- 5. Inject Floating AI Chatbot into Customer Portal Layout -->
    <template id="portal_layout_chatbot_injector" inherit_id="portal.portal_layout" priority="40">
        <xpath expr="//div[@id='wrap']" position="after">
            <t t-call="brightloop_subscription.brightloop_chatbot_widget"/>
        </xpath>
    </template>
</odoo>
