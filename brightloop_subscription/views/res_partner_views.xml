<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_brightloop_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.brightloop.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add Smart Button in partner button box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_subscriptions" 
                        icon="fa-refresh" invisible="subscription_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="active_subscription_count"/> / <field name="subscription_count"/>
                        </span>
                        <span class="o_stat_text">Subscriptions</span>
                    </div>
                </button>
            </xpath>

            <!-- Surface Segment and LTV in Title / Header -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <div class="d-flex align-items-center gap-2 mt-2 mb-3" invisible="subscription_count == 0">
                    <span class="text-muted fw-bold">Subscriber Tier:</span>
                    <field name="subscription_segment" widget="badge" 
                           decoration-success="subscription_segment in ('vip', 'growth')" 
                           decoration-info="subscription_segment == 'starter'" 
                           decoration-danger="subscription_segment == 'at_risk'" 
                           decoration-secondary="subscription_segment == 'churned'"/>
                    <span class="text-muted fw-bold ms-3">Lifetime Subscription Value:</span>
                    <span class="fw-bold text-success fs-6">
                        <field name="lifetime_subscription_revenue" widget="monetary"/>
                    </span>
                </div>
            </xpath>

            <!-- Add Subscriptions Notebook Tab -->
            <xpath expr="//notebook" position="inside">
                <page string="Subscriptions &amp; Contracts" name="brightloop_subscriptions_tab" invisible="subscription_count == 0">
                    <field name="subscription_ids" readonly="1">
                        <tree string="Active &amp; Past Subscriptions">
                            <field name="name"/>
                            <field name="plan_id"/>
                            <field name="state" widget="badge" 
                                   decoration-success="state == 'active'" 
                                   decoration-info="state == 'trial'" 
                                   decoration-warning="state == 'paused'" 
                                   decoration-danger="state == 'past_due'"
                                   decoration-secondary="state in ('cancelled', 'closed')"/>
                            <field name="start_date"/>
                            <field name="next_billing_date"/>
                            <field name="recurring_total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="mrr" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="health_score" widget="progressbar"/>
                            <field name="churn_risk_level" widget="badge" 
                                   decoration-success="churn_risk_level == 'low'" 
                                   decoration-warning="churn_risk_level == 'medium'" 
                                   decoration-danger="churn_risk_level == 'high'"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="auto_renew" widget="boolean_toggle"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
